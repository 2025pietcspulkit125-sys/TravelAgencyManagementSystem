# Copy this file to .env and replace the placeholders with your local MySQL values.
# Keep .env private; it is ignored by the project.
TRAVEL_AGENCY_DB_HOST=127.0.0.1
TRAVEL_AGENCY_DB_PORT=3306
TRAVEL_AGENCY_DB_NAME=travel_agency
TRAVEL_AGENCY_DB_USER=your_mysql_username
TRAVEL_AGENCY_DB_PASSWORD=replace_with_your_mysql_password

# Optional first-run admin bootstrap. If omitted, create users through the app/API.
# Use a unique password of at least 8 characters.
# TRAVEL_AGENCY_DEFAULT_ADMIN_USERNAME=admin
# TRAVEL_AGENCY_DEFAULT_ADMIN_PASSWORD=replace_with_a_long_random_password
